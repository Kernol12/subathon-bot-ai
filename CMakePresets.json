{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "scaffold-debug",
      "displayName": "01 \u00b7 Scaffold (no Qt/GoogleTest required)",
      "inherits": "base"
    },
    {
      "name": "acceptance-debug",
      "displayName": "02 \u00b7 Time-credit acceptance and regression",
      "inherits": "base",
      "cacheVariables": {
        "SUBATHON_BUILD_ACCEPTANCE_TESTS": "ON"
      }
    },
    {
      "name": "qt-probe-debug",
      "displayName": "03 \u00b7 Qt 6.12 environment probe",
      "inherits": "base",
      "cacheVariables": {
        "SUBATHON_BUILD_QT_PROBE": "ON"
      }
    },
    {
      "name": "exact-numeric-debug",
      "displayName": "04 \u00b7 Exact numeric acceptance and regression",
      "inherits": "base",
      "cacheVariables": {
        "SUBATHON_BUILD_EXACT_NUMERIC_TESTS": "ON"
      }
    },
    {
      "name": "timer-lifecycle-debug",
      "displayName": "05 \u00b7 Timer lifecycle acceptance",
      "inherits": "base",
      "cacheVariables": {
        "SUBATHON_BUILD_TIMER_LIFECYCLE_TESTS": "ON"
      }
    },
    {
      "name": "receipt-intake-debug",
      "displayName": "06 \u00b7 Receipt intake simulation acceptance",
      "inherits": "base",
      "cacheVariables": {
        "SUBATHON_BUILD_RECEIPT_INTAKE_TESTS": "ON"
      }
    },
    {
      "name": "contribution-evidence-debug",
