{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "scaffold-debug",
      "displayName": "01 \u00b7 Scaffold (no Qt/GoogleTest required)",
      "inherits": "base"
    },
    {
      "name": "acceptance-debug",
      "displayName": "02 \u00b7 Time-credit acceptance and regression",
      "inherits": "base",
      "cacheVariables": {
        "SUBATHON_BUILD_ACCEPTANCE_TESTS": "ON"
      }
    },
    {
      "name": "qt-probe-debug",
      "displayName": "03 \u00b7 Qt 6.12 environment probe",
      "inherits": "base",
      "cacheVariables": {
        "SUBATHON_BUILD_QT_PROBE": "ON"
      }
    },
    {
      "name": "exact-numeric-debug",
      "displayName": "04 \u00b7 Exact numeric acceptance and regression",
      "inherits": "base",
      "cacheVariables": {
        "SUBATHON_BUILD_EXACT_NUMERIC_TESTS": "ON"
      }
    },
    {
      "name": "timer-lifecycle-debug",
      "displayName": "05 \u00b7 Timer lifecycle acceptance",
      "inherits": "base",
      "cacheVariables": {
        "SUBATHON_BUILD_TIMER_LIFECYCLE_TESTS": "ON"
      }
    },
    {
      "name": "receipt-intake-debug",
      "displayName": "06 \u00b7 Receipt intake simulation acceptance",
      "inherits": "base",
      "cacheVariables": {
        "SUBATHON_BUILD_RECEIPT_INTAKE_TESTS": "ON"
      }
    },
    {
      "name": "contribution-evidence-debug",
      "displayName": "07 \u00b7 Contribution evidence simulation acceptance",
      "inherits": "base",
      "cacheVariables": {
        "SUBATHON_BUILD_CONTRIBUTION_EVIDENCE_TESTS": "ON"
      }
    },
    {
      "name": "pause-policy-debug",
      "displayName": "08 \u00b7 Pause policy acceptance",
      "inherits": "base",
      "cacheVariables": {
        "SUBATHON_BUILD_PAUSE_POLICY_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "scaffold-debug",
      "configurePreset": "scaffold-debug"
    },
    {
      "name": "acceptance-debug",
      "configurePreset": "acceptance-debug"
    },
    {
      "name": "qt-probe-debug",
      "configurePreset": "qt-probe-debug"
    },
    {
      "name": "exact-numeric-debug",
      "configurePreset": "exact-numeric-debug"
    },
    {
      "name": "timer-lifecycle-debug",
      "configurePreset": "timer-lifecycle-debug"
    },
    {
      "name": "receipt-intake-debug",
      "configurePreset": "receipt-intake-debug"
    },
    {
      "name": "contribution-evidence-debug",
      "configurePreset": "contribution-evidence-debug"
    },
    {
      "name": "pause-policy-debug",
      "configurePreset": "pause-policy-debug"
    }
  ],
  "testPresets": [
    {
      "name": "scaffold-debug",
      "configurePreset": "scaffold-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "acceptance-debug",
      "configurePreset": "acceptance-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "qt-probe-debug",
      "configurePreset": "qt-probe-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "exact-numeric-debug",
      "configurePreset": "exact-numeric-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "timer-lifecycle-debug",
      "configurePreset": "timer-lifecycle-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "receipt-intake-debug",
      "configurePreset": "receipt-intake-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "contribution-evidence-debug",
      "configurePreset": "contribution-evidence-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "pause-policy-debug",
      "configurePreset": "pause-policy-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
