      "inherits": "base",
      "cacheVariables": {
        "SUBATHON_BUILD_CONTRIBUTION_EVIDENCE_TESTS": "ON"
      }
    },
    {
      "name": "pause-policy-debug",
      "displayName": "08 \u00b7 Pause policy acceptance",
      "inherits": "base",
      "cacheVariables": {
        "SUBATHON_BUILD_PAUSE_POLICY_TESTS": "ON"
      }
    },
    {
      "name": "application-plan-debug",
      "displayName": "09 \u00b7 Application plan acceptance",
      "inherits": "base",
      "cacheVariables": {
        "SUBATHON_BUILD_APPLICATION_PLAN_TESTS": "ON"
      }
    },
