{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "scaffold-debug",
      "displayName": "01 · Scaffold (no Qt/GoogleTest required)",
      "inherits": "base"
    },
    {
      "name": "acceptance-debug",
      "displayName": "02 · Time-credit acceptance and regression",
      "inherits": "base",
      "cacheVariables": {
        "SUBATHON_BUILD_ACCEPTANCE_TESTS": "ON"
      }
    },
    {
      "name": "qt-probe-debug",
      "displayName": "03 · Qt 6.12 environment probe",
      "inherits": "base",
      "cacheVariables": {
        "SUBATHON_BUILD_QT_PROBE": "ON"
      }
    },
    {
      "name": "exact-numeric-debug",
      "displayName": "04 · Exact numeric acceptance and regression",
      "inherits": "base",
      "cacheVariables": {
        "SUBATHON_BUILD_EXACT_NUMERIC_TESTS": "ON"
      }
    },
    {
      "name": "timer-lifecycle-debug",
      "displayName": "05 · Timer lifecycle acceptance",
      "inherits": "base",
      "cacheVariables": {
        "SUBATHON_BUILD_TIMER_LIFECYCLE_TESTS": "ON"
      }
    },
    {
      "name": "receipt-intake-debug",
      "displayName": "06 · Receipt intake simulation acceptance",
      "inherits": "base",
      "cacheVariables": {
        "SUBATHON_BUILD_RECEIPT_INTAKE_TESTS": "ON"
      }
    },
    {
      "name": "contribution-evidence-debug",
      "displayName": "07 · Contribution evidence simulation acceptance",
      "inherits": "base",
      "cacheVariables": {
        "SUBATHON_BUILD_CONTRIBUTION_EVIDENCE_TESTS": "ON"
      }
    },
    {
      "name": "pause-policy-debug",
      "displayName": "08 · Pause policy acceptance",
      "inherits": "base",
      "cacheVariables": {
        "SUBATHON_BUILD_PAUSE_POLICY_TESTS": "ON"
      }
    },
    {
      "name": "application-plan-debug",
      "displayName": "09 · Application plan acceptance",
      "inherits": "base",
      "cacheVariables": {
        "SUBATHON_BUILD_APPLICATION_PLAN_TESTS": "ON"
      }
    },
    {
      "name": "sqlite-writer-debug",
      "displayName": "10 · Qt SQL SQLite writer acceptance",
      "inherits": "base",
      "cacheVariables": {
        "SUBATHON_BUILD_SQLITE_WRITER_TESTS": "ON"
      }
    },
    {
      "name": "time-debt-debug",
      "displayName": "11 · Time debt acceptance",
      "inherits": "base",
      "cacheVariables": {
        "SUBATHON_BUILD_TIME_DEBT_TESTS": "ON"
      }
    },
    {
      "name": "sqlite-work-debug",
      "displayName": "12 · Writer transaction-work acceptance",
      "inherits": "base",
      "cacheVariables": {
        "SUBATHON_BUILD_SQLITE_WRITER_TESTS": "ON",
        "SUBATHON_BUILD_SQLITE_WORK_TESTS": "ON",
        "SUBATHON_BUILD_QT_PROBE": "ON"
      }
    },
    {
      "name": "sqlite-migrations-debug",
      "displayName": "13 · Migration catalog acceptance",
      "inherits": "base",
      "cacheVariables": {
        "SUBATHON_BUILD_SQLITE_WRITER_TESTS": "ON",
        "SUBATHON_BUILD_SQLITE_WORK_TESTS": "ON",
        "SUBATHON_BUILD_SQLITE_MIGRATION_TESTS": "ON",
        "SUBATHON_BUILD_QT_PROBE": "ON"
      }
    },
    {
      "name": "sqlite-retained-debug",
      "displayName": "14 · Retained configuration/context acceptance",
      "inherits": "sqlite-migrations-debug",
      "cacheVariables": {
        "SUBATHON_BUILD_SQLITE_RETAINED_TESTS": "ON"
      }
    },
    {
      "name": "sqlite-receipt-debug",
      "displayName": "15 · Identified receipt SQLite acceptance",
      "inherits": "sqlite-retained-debug",
      "cacheVariables": {
        "SUBATHON_BUILD_SQLITE_RECEIPT_TESTS": "ON"
      }
    },
    {
      "name": "sqlite-contribution-debug",
      "displayName": "16 · Contribution SQLite acceptance",
      "inherits": "sqlite-receipt-debug",
      "cacheVariables": {
        "SUBATHON_BUILD_SQLITE_CONTRIBUTION_TESTS": "ON"
      }
    },
    {
      "name": "sqlite-plan-debug",
      "displayName": "17 · Captured-plan SQLite acceptance",
      "inherits": "sqlite-contribution-debug",
      "cacheVariables": {
        "SUBATHON_BUILD_SQLITE_PLAN_TESTS": "ON"
      }
    },
    {
      "name": "sqlite-bundle-debug",
      "displayName": "18 · Application-bundle SQLite acceptance",
      "inherits": "sqlite-plan-debug",
      "cacheVariables": {
        "SUBATHON_BUILD_SQLITE_BUNDLE_TESTS": "ON"
      }
    },
    {
      "name": "sqlite-original-claim-debug",
      "displayName": "19 · Typed original-claim SQLite acceptance",
      "inherits": "sqlite-bundle-debug",
      "cacheVariables": {
        "SUBATHON_BUILD_SQLITE_ORIGINAL_CLAIM_TESTS": "ON"
      }
    },
    {
      "name": "sqlite-hold-debug",
      "displayName": "20 · Durable application-hold SQLite acceptance",
      "inherits": "sqlite-original-claim-debug",
      "cacheVariables": {
        "SUBATHON_BUILD_SQLITE_HOLD_TESTS": "ON"
      }
    },
    {
      "name": "application-service-debug",
      "displayName": "21 · Original application-service acceptance",
      "inherits": "sqlite-hold-debug",
      "cacheVariables": {
        "SUBATHON_BUILD_APPLICATION_SERVICE_TESTS": "ON"
      }
    },
    {
      "name": "translation-catalog-debug",
      "displayName": "22 · Translation catalog baseline interfaces",
      "inherits": "qt-probe-debug",
      "cacheVariables": {
        "SUBATHON_BUILD_TRANSLATION_CATALOG_TESTS": "ON"
      }
    },
    {
      "name": "rate-snapshot-debug",
      "displayName": "23 · Rate snapshot baseline interfaces",
      "inherits": "exact-numeric-debug",
      "cacheVariables": {
        "SUBATHON_BUILD_RATE_SNAPSHOT_TESTS": "ON"
      }
    }
  ],
