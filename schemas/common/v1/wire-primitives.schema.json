{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.subathon.invalid/common/v1/wire-primitives.schema.json",
  "title": "Subathon common wire primitives v1",
  "description": "Shared definitions. Select the named primitive and its owning field profile.",
  "$defs": {
    "Integer": {"type": "string", "pattern": "^(?:0|-?[1-9][0-9]*)(?![\\s\\S])"},
    "PositiveInteger": {"type": "string", "pattern": "^(?:[1-9][0-9]*)(?![\\s\\S])"},
    "Signed64": {
      "allOf": [
        {"$ref": "#/$defs/Integer"},
        {
          "type": "string",
          "maxLength": 20,
          "pattern": "^(?:-?(?:0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7]|9223372036854775808))(?![\\s\\S])"
        },
        {
          "not": {"const": "9223372036854775808"}
        }
      ],
      "description": "Integer text from -9223372036854775808 through 9223372036854775807."
    },
    "Unsigned64": {
      "type": "string",
      "maxLength": 20,
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)(?![\\s\\S])",
      "description": "Integer text from 0 through 18446744073709551615."
    },
    "DecimalSource": {
      "type": "string",
      "pattern": "^(?:-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)(?![\\s\\S])"
    },
    "FiniteDecimal": {"type": "string", "pattern": "^(?:0|-?[1-9][0-9]*(?:\\.[0-9]*[1-9])?|-?0\\.[0-9]*[1-9])(?![\\s\\S])"},
    "Rational": {
      "type": "object",
      "properties": {
        "numerator": {"$ref": "#/$defs/Integer"},
        "denominator": {"$ref": "#/$defs/PositiveInteger"}
      },
      "required": ["numerator", "denominator"],
      "additionalProperties": false,
      "description": "Use the field's bound and verify reduced form. Zero requires denominator 1."
    },
    "OpaqueBytes": {"type": "string", "pattern": "^(?:(?:[0-9a-f]{2})*)(?![\\s\\S])"},
    "Text": {
      "type": "string",
      "description": "A Unicode scalar string. The JSON lexical layer checks UTF-8 and rejects lone surrogates."
    },
    "ProtocolIdentifier": {"type": "string", "maxLength": 64, "pattern": "^(?:[a-z][a-z0-9_.-]{0,63})(?![\\s\\S])"},
    "CapabilityIdentifier": {"$ref": "#/$defs/ProtocolIdentifier"},
    "CorrelationReference": {
      "allOf": [{"$ref": "#/$defs/OpaqueBytes"}, {"minLength": 2}, {"maxLength": 512}]
    },
    "OperationReference": {"$ref": "#/$defs/NonemptyOpaqueBytes"},
    "RevisionReference": {"$ref": "#/$defs/NonemptyOpaqueBytes"},
    "RevisionCounter": {"$ref": "#/$defs/Unsigned64"},
    "CommonFailure": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "invalid_encoding",
            "invalid_json",
            "invalid_primitive",
            "resource_limit",
            "incompatible_version",
            "unsupported_capability",
            "not_authorized",
            "conflict",
            "unavailable",
            "outcome_unknown"
          ]
        },
        "correlation_id": {
          "oneOf": [{"$ref": "#/$defs/CorrelationReference"}, {"type": "null"}]
        }
      },
      "required": ["code", "correlation_id"],
      "additionalProperties": false,
      "description": "Maximum serialized CommonFailure size is 1024 UTF-8 JSON bytes."
    },
    "NonemptyOpaqueBytes": {
      "allOf": [{"$ref": "#/$defs/OpaqueBytes"}, {"minLength": 2}]
    }
  }
}
