{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.subathon.invalid/scene/v1/bindings.schema.json",
  "title": "Subathon scene binding definitions v1",
  "type": "object",
  "properties": {
    "version": {"const": "subathon.scene-bindings-conditions-timeline.v1"},
    "locale": {
      "allOf": [
        {"$ref": "https://schemas.subathon.invalid/common/v1/wire-primitives.schema.json#/$defs/Text"},
        {"maxLength": 65536},
        {"minLength": 1}
      ],
      "description": "Inert text. UTF-8 byte limits and the owning interpretation apply."
    },
    "definitions": {
      "type": "array",
      "items": {"$ref": "#/$defs/Definition"},
      "maxItems": 32768
    }
  },
  "required": ["version", "locale", "definitions"],
  "additionalProperties": false,
  "description": "Authored definitions for one selected dependency closure. Runtime observations remain with their source owners.",
  "$defs": {
    "DefinitionIdentity": {
      "allOf": [
        {
          "$ref": "https://schemas.subathon.invalid/common/v1/wire-primitives.schema.json#/$defs/NonemptyOpaqueBytes"
        },
        {"maxLength": 131072}
      ]
    },
    "DomainReference": {
      "allOf": [
        {
          "$ref": "https://schemas.subathon.invalid/common/v1/wire-primitives.schema.json#/$defs/NonemptyOpaqueBytes"
        },
        {"maxLength": 6291456}
      ],
      "description": "Existing owner bounds apply inside the outer token ceiling."
    },
    "TimerBindingRef": {
      "type": "object",
      "properties": {
        "kind": {"const": "TimerBinding"},
        "version": {"const": "subathon.scene-bindings-conditions-timeline.v1"},
        "resourceId": {"$ref": "#/$defs/DefinitionIdentity"},
        "definitionId": {"$ref": "#/$defs/DefinitionIdentity"}
      },
      "required": ["kind", "version", "resourceId", "definitionId"],
      "additionalProperties": false
    },
    "TextBindingRef": {
      "type": "object",
      "properties": {
        "kind": {"const": "TextBinding"},
        "version": {"const": "subathon.scene-bindings-conditions-timeline.v1"},
        "resourceId": {"$ref": "#/$defs/DefinitionIdentity"},
        "definitionId": {"$ref": "#/$defs/DefinitionIdentity"}
      },
      "required": ["kind", "version", "resourceId", "definitionId"],
      "additionalProperties": false
    },
    "ProgressBindingRef": {
      "type": "object",
      "properties": {
        "kind": {"const": "ProgressBinding"},
        "version": {"const": "subathon.scene-bindings-conditions-timeline.v1"},
        "resourceId": {"$ref": "#/$defs/DefinitionIdentity"},
        "definitionId": {"$ref": "#/$defs/DefinitionIdentity"}
      },
      "required": ["kind", "version", "resourceId", "definitionId"],
      "additionalProperties": false
    },
    "RecentSupportBindingRef": {
      "type": "object",
      "properties": {
        "kind": {"const": "RecentSupportBinding"},
        "version": {"const": "subathon.scene-bindings-conditions-timeline.v1"},
        "resourceId": {"$ref": "#/$defs/DefinitionIdentity"},
        "definitionId": {"$ref": "#/$defs/DefinitionIdentity"}
      },
      "required": ["kind", "version", "resourceId", "definitionId"],
      "additionalProperties": false
    },
    "AnnouncementBindingRef": {
      "type": "object",
      "properties": {
        "kind": {"const": "AnnouncementBinding"},
        "version": {"const": "subathon.scene-bindings-conditions-timeline.v1"},
        "resourceId": {"$ref": "#/$defs/DefinitionIdentity"},
        "definitionId": {"$ref": "#/$defs/DefinitionIdentity"}
      },
      "required": ["kind", "version", "resourceId", "definitionId"],
      "additionalProperties": false
    },
    "ElementBindingsRef": {
      "type": "object",
      "properties": {
        "kind": {"const": "ElementBindings"},
        "version": {"const": "subathon.scene-bindings-conditions-timeline.v1"},
        "resourceId": {"$ref": "#/$defs/DefinitionIdentity"},
        "definitionId": {"$ref": "#/$defs/DefinitionIdentity"}
      },
      "required": ["kind", "version", "resourceId", "definitionId"],
      "additionalProperties": false
    },
    "ConditionRef": {
      "type": "object",
      "properties": {
        "kind": {"const": "Condition"},
        "version": {"const": "subathon.scene-bindings-conditions-timeline.v1"},
        "resourceId": {"$ref": "#/$defs/DefinitionIdentity"},
        "definitionId": {"$ref": "#/$defs/DefinitionIdentity"}
      },
      "required": ["kind", "version", "resourceId", "definitionId"],
      "additionalProperties": false
    },
    "AnimationRef": {
      "type": "object",
      "properties": {
        "kind": {"const": "Animation"},
        "version": {"const": "subathon.scene-bindings-conditions-timeline.v1"},
        "resourceId": {"$ref": "#/$defs/DefinitionIdentity"},
        "definitionId": {"$ref": "#/$defs/DefinitionIdentity"}
      },
      "required": ["kind", "version", "resourceId", "definitionId"],
      "additionalProperties": false
    },
    "FormattingRef": {
      "type": "object",
      "properties": {
        "kind": {"const": "Formatting"},
        "version": {"const": "subathon.scene-bindings-conditions-timeline.v1"},
        "resourceId": {"$ref": "#/$defs/DefinitionIdentity"},
        "definitionId": {"$ref": "#/$defs/DefinitionIdentity"}
      },
      "required": ["kind", "version", "resourceId", "definitionId"],
      "additionalProperties": false
    },
    "PresentationLayoutRef": {
      "type": "object",
      "properties": {
        "kind": {"const": "PresentationLayout"},
        "version": {"const": "subathon.scene-bindings-conditions-timeline.v1"},
        "resourceId": {"$ref": "#/$defs/DefinitionIdentity"},
        "definitionId": {"$ref": "#/$defs/DefinitionIdentity"}
      },
      "required": ["kind", "version", "resourceId", "definitionId"],
      "additionalProperties": false
    },
    "ElapsedMilliseconds": {
      "allOf": [
        {"$ref": "https://schemas.subathon.invalid/common/v1/wire-primitives.schema.json#/$defs/Signed64"},
        {
          "$ref": "https://schemas.subathon.invalid/common/v1/wire-primitives.schema.json#/$defs/Unsigned64"
        }
      ]
    },
    "PositiveMilliseconds": {
      "allOf": [
        {"$ref": "#/$defs/ElapsedMilliseconds"},
        {
          "not": {"const": "0"}
        }
      ]
    },
    "FactorLiteral": {
      "allOf": [
        {
          "$ref": "https://schemas.subathon.invalid/common/v1/wire-primitives.schema.json#/$defs/DecimalSource"
        },
        {"maxLength": 512}
      ],
      "description": "Check CORE-001 mantissa and exponent bounds and exact nonnegative range. Preserve the original spelling, including signed zero."
    },
    "ProgressLiteral": {
      "allOf": [
        {"$ref": "https://schemas.subathon.invalid/common/v1/wire-primitives.schema.json#/$defs/Rational"},
        {
          "type": "object",
          "properties": {
            "numerator": {"type": "string", "maxLength": 256, "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"},
            "denominator": {
              "allOf": [
                {
                  "$ref": "https://schemas.subathon.invalid/common/v1/wire-primitives.schema.json#/$defs/PositiveInteger"
                },
                {"maxLength": 256}
              ]
            }
          },
          "required": ["numerator", "denominator"],
          "additionalProperties": false
        }
      ],
      "description": "Reduced rational in [0,1]. Compare exactly and validate component bounds before reduction."
    },
    "LifecycleOperand": {
      "type": "object",
      "properties": {
        "field": {"const": "timer.lifecycle"}
      },
      "required": ["field"],
      "additionalProperties": false
    },
    "PhaseOperand": {
      "type": "object",
      "properties": {
        "field": {"const": "timer.phase"}
      },
      "required": ["field"],
      "additionalProperties": false
    },
    "BooleanOperand": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "field": {
              "enum": ["timer.awaitingConfirmation", "pause.active", "pause.streamUnknownNotice"]
            }
          },
          "required": ["field"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {"const": "pause.reason"},
            "reason": {
              "enum": [
                "Manual",
                "Schedule",
                "StreamOffline",
                "DesignatedClientDisconnected",
                "RecoveryReview",
                "StreamStatusUnknown"
              ]
            }
          },
          "required": ["field", "reason"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {"const": "modifier.active"},
            "instanceId": {"$ref": "#/$defs/DomainReference"}
          },
          "required": ["field", "instanceId"],
          "additionalProperties": false
        }
      ]
    },
    "ModifierModeOperand": {
      "type": "object",
      "properties": {
        "field": {"const": "modifier.mode"},
        "instanceId": {"$ref": "#/$defs/DomainReference"}
      },
      "required": ["field", "instanceId"],
      "additionalProperties": false
    },
    "PositionOperand": {
      "type": "object",
      "properties": {
        "field": {"const": "track.position"}
      },
      "required": ["field"],
      "additionalProperties": false
    },
    "DurationOperand": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "field": {
              "enum": ["timer.main", "timer.grace"]
            }
          },
          "required": ["field"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {"const": "modifier.remaining"},
            "instanceId": {"$ref": "#/$defs/DomainReference"}
          },
          "required": ["field", "instanceId"],
          "additionalProperties": false
        }
      ]
    },
    "FactorOperand": {
      "type": "object",
      "properties": {
        "field": {"const": "modifier.factor"},
        "instanceId": {"$ref": "#/$defs/DomainReference"},
        "targetOrdinal": {
          "$ref": "https://schemas.subathon.invalid/common/v1/wire-primitives.schema.json#/$defs/Unsigned64"
        }
      },
      "required": ["field", "instanceId", "targetOrdinal"],
      "additionalProperties": false
    },
    "PointsOperand": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "field": {
              "enum": ["track.score", "track.previousTarget", "track.nextTarget"]
            }
          },
          "required": ["field"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {"const": "target.current"},
            "milestoneId": {"$ref": "#/$defs/DomainReference"}
          },
          "required": ["field", "milestoneId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "enum": ["achievement.target", "achievement.score"]
            },
            "milestoneId": {"$ref": "#/$defs/DomainReference"},
            "captureId": {"$ref": "#/$defs/DomainReference"}
          },
          "required": ["field", "milestoneId", "captureId"],
          "additionalProperties": false
        }
      ]
    },
    "PointDistanceOperand": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "field": {
              "enum": ["track.deficit", "track.remaining"]
            }
          },
          "required": ["field"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {"const": "target.deficit"},
            "milestoneId": {"$ref": "#/$defs/DomainReference"}
          },
          "required": ["field", "milestoneId"],
          "additionalProperties": false
        }
      ]
    },
    "ProgressOperand": {
      "type": "object",
      "properties": {
        "field": {"const": "track.progress"}
      },
      "required": ["field"],
      "additionalProperties": false
    },
    "TimerOperand": {"$ref": "#/$defs/DurationOperand"},
    "TextOperand": {
      "oneOf": [
        {"$ref": "#/$defs/LifecycleOperand"},
        {"$ref": "#/$defs/PhaseOperand"},
        {"$ref": "#/$defs/BooleanOperand"},
        {"$ref": "#/$defs/ModifierModeOperand"},
        {"$ref": "#/$defs/PositionOperand"},
        {"$ref": "#/$defs/DurationOperand"},
        {"$ref": "#/$defs/FactorOperand"},
        {"$ref": "#/$defs/PointsOperand"},
        {"$ref": "#/$defs/PointDistanceOperand"},
        {"$ref": "#/$defs/ProgressOperand"},
        {
          "type": "object",
          "properties": {
            "field": {"const": "modifier.name"},
            "instanceId": {"$ref": "#/$defs/DomainReference"}
          },
          "required": ["field", "instanceId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {"const": "milestone.description"},
            "milestoneId": {"$ref": "#/$defs/DomainReference"},
            "text": {
              "allOf": [
                {
                  "$ref": "https://schemas.subathon.invalid/common/v1/wire-primitives.schema.json#/$defs/Text"
                },
                {"maxLength": 1048576}
              ]
            }
          },
          "required": ["field", "milestoneId", "text"],
          "additionalProperties": false
        }
      ]
    },
    "ConditionExpression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {"const": "all"},
            "children": {
              "type": "array",
              "items": {"$ref": "#/$defs/ConditionExpression"},
              "maxItems": 4095,
              "minItems": 1
            }
          },
          "required": ["kind", "children"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "any"},
            "children": {
              "type": "array",
              "items": {"$ref": "#/$defs/ConditionExpression"},
              "maxItems": 4095,
              "minItems": 1
            }
          },
          "required": ["kind", "children"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "not"},
            "child": {"$ref": "#/$defs/ConditionExpression"}
          },
          "required": ["kind", "child"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "comparison-lifecycle"},
            "operand": {"$ref": "#/$defs/LifecycleOperand"},
            "operator": {
              "enum": ["eq", "ne"]
            },
            "literal": {
              "enum": ["Ready", "Active", "Finished"]
            }
          },
          "required": ["kind", "operand", "operator", "literal"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "comparison-phase"},
            "operand": {"$ref": "#/$defs/PhaseOperand"},
            "operator": {
              "enum": ["eq", "ne"]
            },
            "literal": {
              "enum": ["Main", "Grace"]
            }
          },
          "required": ["kind", "operand", "operator", "literal"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "comparison-boolean"},
            "operand": {"$ref": "#/$defs/BooleanOperand"},
            "operator": {
              "enum": ["eq", "ne"]
            },
            "literal": {"type": "boolean"}
          },
          "required": ["kind", "operand", "operator", "literal"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "comparison-modifier-mode"},
            "operand": {"$ref": "#/$defs/ModifierModeOperand"},
            "operator": {
              "enum": ["eq", "ne"]
            },
            "literal": {
              "enum": ["ActiveSubathon", "RealElapsed"]
            }
          },
          "required": ["kind", "operand", "operator", "literal"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "comparison-position"},
            "operand": {"$ref": "#/$defs/PositionOperand"},
            "operator": {
              "enum": ["eq", "ne"]
            },
            "literal": {
              "enum": ["empty", "before_first", "between_targets", "all_completed"]
            }
          },
          "required": ["kind", "operand", "operator", "literal"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "comparison-duration"},
            "operand": {"$ref": "#/$defs/DurationOperand"},
            "operator": {
              "enum": ["eq", "ne", "lt", "le", "gt", "ge"]
            },
            "literal": {"$ref": "#/$defs/ElapsedMilliseconds"}
          },
          "required": ["kind", "operand", "operator", "literal"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "comparison-factor"},
            "operand": {"$ref": "#/$defs/FactorOperand"},
            "operator": {
              "enum": ["eq", "ne", "lt", "le", "gt", "ge"]
            },
            "literal": {"$ref": "#/$defs/FactorLiteral"}
          },
          "required": ["kind", "operand", "operator", "literal"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "comparison-points"},
            "operand": {"$ref": "#/$defs/PointsOperand"},
            "operator": {
              "enum": ["eq", "ne", "lt", "le", "gt", "ge"]
            },
            "literal": {
              "$ref": "https://schemas.subathon.invalid/common/v1/wire-primitives.schema.json#/$defs/Signed64"
            }
          },
          "required": ["kind", "operand", "operator", "literal"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "comparison-point-distance"},
            "operand": {"$ref": "#/$defs/PointDistanceOperand"},
            "operator": {
              "enum": ["eq", "ne", "lt", "le", "gt", "ge"]
            },
            "literal": {
              "$ref": "https://schemas.subathon.invalid/common/v1/wire-primitives.schema.json#/$defs/Unsigned64"
            }
          },
          "required": ["kind", "operand", "operator", "literal"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "comparison-progress"},
            "operand": {"$ref": "#/$defs/ProgressOperand"},
            "operator": {
              "enum": ["eq", "ne", "lt", "le", "gt", "ge"]
            },
            "literal": {"$ref": "#/$defs/ProgressLiteral"}
          },
          "required": ["kind", "operand", "operator", "literal"],
          "additionalProperties": false
        }
      ],
      "description": "A complete condition has at most 4096 nodes and depth 64. Validate every branch before evaluation."
    },
    "TimerBindingDefinition": {
      "type": "object",
      "properties": {
        "kind": {"const": "TimerBinding"},
        "resourceId": {"$ref": "#/$defs/DefinitionIdentity"},
        "definitionId": {"$ref": "#/$defs/DefinitionIdentity"},
        "operand": {"$ref": "#/$defs/TimerOperand"},
        "format": {"$ref": "#/$defs/FormattingRef"},
        "unavailableText": {
          "allOf": [
            {"$ref": "https://schemas.subathon.invalid/common/v1/wire-primitives.schema.json#/$defs/Text"},
            {"maxLength": 1048576}
          ]
        }
      },
      "required": ["kind", "resourceId", "definitionId", "operand", "format"],
      "additionalProperties": false
    },
    "TextBindingDefinition": {
      "type": "object",
      "properties": {
        "kind": {"const": "TextBinding"},
        "resourceId": {"$ref": "#/$defs/DefinitionIdentity"},
        "definitionId": {"$ref": "#/$defs/DefinitionIdentity"},
        "operand": {"$ref": "#/$defs/TextOperand"},
        "format": {"$ref": "#/$defs/FormattingRef"},
        "unavailableText": {
          "allOf": [
            {"$ref": "https://schemas.subathon.invalid/common/v1/wire-primitives.schema.json#/$defs/Text"},
            {"maxLength": 1048576}
          ]
        }
      },
      "required": ["kind", "resourceId", "definitionId", "operand", "format"],
      "additionalProperties": false
    },
    "ProgressBindingDefinition": {
      "type": "object",
      "properties": {
        "kind": {"const": "ProgressBinding"},
        "resourceId": {"$ref": "#/$defs/DefinitionIdentity"},
        "definitionId": {"$ref": "#/$defs/DefinitionIdentity"},
        "operand": {
          "type": "object",
          "properties": {
            "field": {"const": "track.progress"}
          },
          "required": ["field"],
          "additionalProperties": false
        }
      },
      "required": ["kind", "resourceId", "definitionId", "operand"],
      "additionalProperties": false
    },
    "RecentSupportBindingDefinition": {
      "type": "object",
      "properties": {
        "kind": {"const": "RecentSupportBinding"},
        "resourceId": {"$ref": "#/$defs/DefinitionIdentity"},
        "definitionId": {"$ref": "#/$defs/DefinitionIdentity"},
        "operand": {
          "type": "object",
          "properties": {
            "field": {"const": "support.rows"}
          },
          "required": ["field"],
          "additionalProperties": false
        }
      },
      "required": ["kind", "resourceId", "definitionId", "operand"],
      "additionalProperties": false
    },
    "AnnouncementBindingDefinition": {
      "type": "object",
      "properties": {
        "kind": {"const": "AnnouncementBinding"},
        "resourceId": {"$ref": "#/$defs/DefinitionIdentity"},
        "definitionId": {"$ref": "#/$defs/DefinitionIdentity"},
        "operand": {
          "type": "object",
          "properties": {
            "field": {"const": "announcement.current"}
          },
          "required": ["field"],
          "additionalProperties": false
        }
      },
      "required": ["kind", "resourceId", "definitionId", "operand"],
      "additionalProperties": false
    },
    "ElementBindingsDefinition": {
      "type": "object",
      "properties": {
        "kind": {"const": "ElementBindings"},
        "resourceId": {"$ref": "#/$defs/DefinitionIdentity"},
        "definitionId": {"$ref": "#/$defs/DefinitionIdentity"},
        "opacity": {"$ref": "#/$defs/ProgressOperand"}
      },
      "required": ["kind", "resourceId", "definitionId", "opacity"],
      "additionalProperties": false
    },
    "ConditionDefinition": {
      "type": "object",
      "properties": {
        "kind": {"const": "Condition"},
        "resourceId": {"$ref": "#/$defs/DefinitionIdentity"},
        "definitionId": {"$ref": "#/$defs/DefinitionIdentity"},
        "expression": {"$ref": "#/$defs/ConditionExpression"}
      },
      "required": ["kind", "resourceId", "definitionId", "expression"],
      "additionalProperties": false
    },
    "FormattingDefinition": {
      "type": "object",
      "properties": {
        "kind": {"const": "Formatting"},
        "resourceId": {"$ref": "#/$defs/DefinitionIdentity"},
        "definitionId": {"$ref": "#/$defs/DefinitionIdentity"},
        "format": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {"const": "literal-text"}
              },
              "required": ["kind"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {"const": "catalog-label"}
              },
              "required": ["kind"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {"const": "exact-money"}
              },
              "required": ["kind"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {"const": "gift-count"}
              },
              "required": ["kind"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {"const": "bits-count"}
              },
              "required": ["kind"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {"const": "duration"},
                "pattern": {
                  "enum": ["H:MM:SS", "H:MM:SS.mmm"]
                }
              },
              "required": ["kind", "pattern"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {"const": "points"},
                "precision": {"type": "integer", "minimum": 0, "maximum": 6}
              },
              "required": ["kind", "precision"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {"const": "percent"},
                "precision": {"type": "integer", "minimum": 0, "maximum": 6}
              },
              "required": ["kind", "precision"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {"const": "exact-factor"},
                "multiplierMarker": {
                  "allOf": [
                    {
