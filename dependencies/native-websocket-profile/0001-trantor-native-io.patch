+void TcpConnectionImpl::retireNativeProfileSocket()
+{
+    // Detach the poller entry before releasing the numeric fd for reuse. A
+    // retained WebSocketConnection must not retain a closed connection's socket.
+    if (!nativeProfileChannelRemoved_)
+    {
+        ioChannelPtr_->remove();
+        nativeProfileChannelRemoved_ = true;
+        socketPtr_->closeNativeProfile();
+        readBuffer_.releaseNativeProfileStorage();
+        writeBufferList_.clear();
+        pendingTlsWriteBufferList_.clear();
+    }
+}
+void TcpConnectionImpl::establishNativeProfile()
+{
+    loop_->assertInLoopThread();
+    assert(nativeProfileIo());
+    // Native absolute deadlines replace HTTP idle kickoff, including idle forever.
+    // Reset the entry's weak connection BEFORE dropping our weak reference: the
+    // TimingWheel may retain the entry until expiry, but its destructor is inert.
+    auto entry = kickoffEntry_.lock();
+    if (entry) entry->reset();
+    kickoffEntry_.reset();
+    idleTimeout_ = 0;
+    idleTimeoutBackup_ = 0; // No async-stream restoration of an HTTP idle policy.
+}
