+        done_=true; slot->pending_parse=false; transport->reading(false);
+        sink_->complete(*bounded_); return 1;
+    }
+    if(buf->readableBytes()) { slot->pending_parse=true; transport->reading(false); }
+    else { slot->pending_parse=false; transport->reading(true); }
+    return 0;
+}
