+    "subathon.bounded-http-foundation.v1";
+namespace drogon::native_profile {
+NativeRegistration *&Runtime::registration() noexcept { static NativeRegistration *value=nullptr; return value; }
+}
+namespace drogon::bounded_http_sdk {
+Facts facts;
+std::atomic<trantor::EventLoop*> bound_loop{nullptr};
+std::atomic<HttpServer*> bound_servers[2]{};
+std::atomic<bool> run_started{false}, io_joined{false}, run_cleaned{false};
+namespace {
+trantor::bounded_io::Producer *producer=nullptr;
+Sink *consumer=nullptr;
+bool listeners[2]{};
+bool install_attempted=false;
+std::thread::id installing_thread;
+unsigned next_role=0;
+InstallFailure install_error=InstallFailure::none;
+}
+Sink *sink() noexcept { return consumer; }
+void bind_server(HttpServer &s,trantor::bounded_io::Role role,trantor::EventLoop &loop) noexcept {
+    if(bound_loop && bound_loop!=&loop) std::terminate();
+    bound_loop=&loop; bound_servers[static_cast<unsigned>(role)]=&s;
+}
+bool Runtime::observe(trantor::bounded_io::Producer &p,Facts &out) noexcept {
+    auto *loop=bound_loop.load(std::memory_order_acquire);
+    if(producer!=&p || !loop || !loop->isInLoopThread()) return false;
+    out=facts;
+    out.stock_output_appends=trantor::bounded_io::detail::stock_output_appends.load(std::memory_order_relaxed);
+    out.constructed=trantor::bounded_io::detail::constructed.load(std::memory_order_relaxed);
+    out.sdk_retained_peers=trantor::bounded_io::detail::retained.load(std::memory_order_relaxed);
+    out.peak_sdk_retained_peers=trantor::bounded_io::detail::peak_retained.load(std::memory_order_relaxed);
+    return true;
+}
+bool Runtime::install(trantor::bounded_io::Producer &p,Sink &s,U64 peers) noexcept {
+    auto &budget=trantor::bounded_io::detail::bootstrap_budget();
+    auto &app=HttpAppFrameworkImpl::instance();
+    auto &routes=HttpControllersRouter::instance();
+    install_error=InstallFailure::invalid_state;
+    if(producer || install_attempted || run_started.load(std::memory_order_acquire) || app.isRunning() || !budget.main_ready || budget.peers) return false;
+    install_error=InstallFailure::invalid_config;
+    if(!peers || peers>static_cast<U64>(INT_MAX)-8 || app.getThreadNum()!=1 ||
+       app.getLoop()->boundedRecords_!=16 || !app.listenerManagerPtr_->listeners_.empty() ||
+       !routes.ctrlMap_.empty() || !routes.simpleCtrlMap_.empty() ||
+       !routes.ctrlVector_.empty() || !routes.wsCtrlMap_.empty() || !routes.wsCtrlVector_.empty() ||
+       !app.getLoop()->funcs_.empty()) return false;
+    // Query the selected standard-library bucket policy before any projection
+    // allocation, rather than accepting a post-construction capacity observation.
+    std::__detail::_Prime_rehash_policy request_policy, response_policy;
+    if(request_policy._M_next_bkt(5)>32 || response_policy._M_next_bkt(3)>32)
+        return false;
+    installing_thread=std::this_thread::get_id();
+    install_attempted=true;
+    try {
+        // Allocate once before run: future IO0 only adopts these actual arrays.
+        const auto records=static_cast<std::size_t>(peers)+8;
+        budget.io_events.resize(records*16);
+        budget.io_active.reserve(records);
+#ifndef NDEBUG
+        budget.io_debug.resize(records);
+#endif
+    } catch(...) {
+        std::vector<std::byte>{}.swap(budget.io_events);
+        std::vector<trantor::Channel*>{}.swap(budget.io_active);
+        std::vector<std::pair<int,trantor::Channel*>>{}.swap(budget.io_debug);
+        install_error=InstallFailure::allocation_failure;
+        return false;
+    }
+    budget.peers=peers;
+    producer=&p; consumer=&s; install_error=InstallFailure::none; return true;
+}
+InstallFailure Runtime::install_failure() noexcept { return install_error; }
+bool Runtime::discard(trantor::bounded_io::Producer &p) noexcept {
+    auto &app=HttpAppFrameworkImpl::instance();
+    if(run_started.load(std::memory_order_acquire) &&
+       (!io_joined.load(std::memory_order_acquire) || !run_cleaned.load(std::memory_order_acquire))) return false;
+    if(std::this_thread::get_id()!=installing_thread || producer!=&p || bound_servers[0] || bound_servers[1] || app.isRunning()) return false;
+    if(app.listenerManagerPtr_) {
+        auto &records=app.listenerManagerPtr_->listeners_;
+        records.erase(std::remove_if(records.begin(),records.end(),
+            [&p](const auto &entry){return entry.bounded_==&p;}),records.end());
+    }
+    trantor::bounded_io::bind_wake_fd(-1);
+    bound_loop.store(nullptr,std::memory_order_release);
+    producer=nullptr; consumer=nullptr; listeners[0]=listeners[1]=false;
+    auto &budget=trantor::bounded_io::detail::bootstrap_budget();
+    budget.peers=0;
+    std::vector<std::byte>{}.swap(budget.io_events);
+    std::vector<trantor::Channel*>{}.swap(budget.io_active);
+    std::vector<std::pair<int,trantor::Channel*>>{}.swap(budget.io_debug);
+    return true; // The attempted-install latch is deliberately not reset.
+}
+
+
+bool Runtime::listener(HttpAppFramework &app,Endpoint endpoint,trantor::bounded_io::Role role) noexcept {
+    const auto index=static_cast<unsigned>(role);
+    if(!producer || &app!=&drogon::app() || app.isRunning() || app.getThreadNum()!=1 ||
+       index>1 || listeners[index] || endpoint.address.back()!=0) return false;
+    in_addr ipv4{}; in6_addr ipv6{};
+    if(::inet_pton(AF_INET,endpoint.address.data(),&ipv4)!=1 &&
+       ::inet_pton(AF_INET6,endpoint.address.data(),&ipv6)!=1) return false;
+    try {
+        const auto address=std::string(endpoint.address.data());
+        static_cast<HttpAppFrameworkImpl&>(app).listenerManagerPtr_->addListener(
+            address,endpoint.port,false,"","",false,{},index==1,producer,role);
+        listeners[index]=true; return true;
+    } catch(...) { return false; }
+}
+bool Runtime::stop_acceptors() noexcept {
+    auto *loop=bound_loop.load(std::memory_order_acquire);
+    if(!loop || !loop->isInLoopThread()) return false;
+    bool complete=true;
+    for(auto &record:bound_servers) if(auto *server=record.load(std::memory_order_acquire); server && !server->boundedStopAccepting()) complete=false;
+    return complete;
+}
+void Runtime::poll() noexcept {
+    auto *loop=bound_loop.load(std::memory_order_acquire);
+    if(!loop || !loop->isInLoopThread()) return;
+    for(unsigned step=0;step<2;++step) {
+        auto *server=bound_servers[(next_role+step)%2].load(std::memory_order_acquire);
+        if(server) server->boundedPoll();
+    }
+    next_role^=1;
+}
+bool Runtime::bind_wake(trantor::bounded_io::Producer &p,int fd) noexcept {
+    auto *loop=bound_loop.load(std::memory_order_acquire);
+    if(!loop || !loop->isInLoopThread() || &p!=producer || fd<0) return false;
+    trantor::bounded_io::bind_wake_fd(fd); return true;
+}
+const native_profile::NativeRegistration *Runtime::native_registration() noexcept {
+    return native_profile::Runtime::registration();
+}
+std::size_t Runtime::render_reply(std::span<std::byte> out,std::uint16_t status,U64 n,bool close) noexcept {
+    auto *loop=bound_loop.load(std::memory_order_acquire);
+    if(!loop || !loop->isInLoopThread()) return 0;
+    return HttpResponseImpl::renderBounded(out,status,n,close);
+}
+std::size_t control(std::span<std::byte> out,std::uint16_t status) noexcept {
+    std::string_view wire;
+    switch(status) {
+    case 400: wire="HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"; break;
+    case 413: wire="HTTP/1.1 413 Payload Too Large\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"; break;
+    case 414: wire="HTTP/1.1 414 URI Too Long\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"; break;
+    case 431: wire="HTTP/1.1 431 Request Header Fields Too Large\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"; break;
+    default: return 0;
+    }
+    if(out.size()<wire.size()) return 0;
+    std::memcpy(out.data(),wire.data(),wire.size()); return wire.size();
+}
+bool Runtime::arm_first_wire() noexcept { return producer && !bound_loop && trantor::bounded_io::arm_wire_gate(); }
+bool Runtime::wire_held() noexcept { auto *loop=bound_loop.load(std::memory_order_acquire); return loop && loop->isInLoopThread() && trantor::bounded_io::wire_held(); }
+bool Runtime::release_wire() noexcept { auto *loop=bound_loop.load(std::memory_order_acquire); return loop && loop->isInLoopThread() && trantor::bounded_io::release_wire_gate(); }
+}
