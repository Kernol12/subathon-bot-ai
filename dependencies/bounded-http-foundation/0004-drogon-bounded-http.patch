+std::size_t drogon::HttpResponseImpl::renderBounded(std::span<std::byte> out,
+    std::uint16_t status,std::uint64_t bytes,bool close) noexcept {
+    if(status!=200 || out.size()<128) return 0;
+    constexpr std::string_view prefix="HTTP/1.1 200 OK\r\nContent-Length: ";
+    const std::string_view suffix=close ? "\r\nConnection: close\r\n\r\n" : "\r\nConnection: keep-alive\r\n\r\n";
+    auto *p=reinterpret_cast<char*>(out.data());
+    std::memcpy(p,prefix.data(),prefix.size()); p+=prefix.size();
+    const auto result=std::to_chars(p,reinterpret_cast<char*>(out.data())+128,bytes);
+    if(result.ec!=std::errc{}) return 0;
+    p=result.ptr; std::memcpy(p,suffix.data(),suffix.size()); p+=suffix.size();
+    return static_cast<std::size_t>(p-reinterpret_cast<char*>(out.data()));
+}
