+        if(!bounded_->wipe_receive({reinterpret_cast<std::byte*>(const_cast<char*>(raw)),scan_},false)) { transport->close(); return 0; }
+        buf->retrieve(scan_); headDone_=true;
+    }
+    if(bodyRemaining_ && budget && buf->readableBytes()) {
+        const auto n=std::min<std::uint64_t>({bodyRemaining_,budget,buf->readableBytes()});
+        const auto bytes=std::span<const std::byte>(reinterpret_cast<const std::byte*>(buf->peek()),static_cast<std::size_t>(n));
