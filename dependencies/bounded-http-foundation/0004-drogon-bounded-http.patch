+                selected.binderPtr->handleRequest(projected,[&](const HttpResponsePtr &response) {
+                    const auto &accept=response->getHeader("sec-websocket-accept");
+                    if(response->statusCode()!=k101SwitchingProtocols || accept.size()!=28) return;
+                    constexpr std::string_view prefix="HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: ";
+                    if(out.size()<prefix.size()+32) return;
+                    std::memcpy(out.data(),prefix.data(),prefix.size());
+                    std::memcpy(out.data()+prefix.size(),accept.data(),28);
+                    std::memcpy(out.data()+prefix.size()+28,"\r\n\r\n",4);
+                    slot->control_busy=true;
+                    queued=transport->wire(out.first(prefix.size()+32),out.data());
