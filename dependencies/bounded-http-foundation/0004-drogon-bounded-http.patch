+            if(ch!='\n') continue;
+            const auto end=scan_-1;
+            const bool cr=end>lineStart_ && raw[end-1]=='\r';
+            const auto lineEnd=cr ? end-1 : end;
+            if(!cr) syntaxBad_=true;
+            const std::string_view line(raw+lineStart_,lineEnd-lineStart_);
+            if(lineStart_==0) {
+                lineBytes_=scan_;
+                const auto a=line.find(' ');
+                const auto b=a==line.npos ? line.npos : line.find(' ',a+1);
+                if(a==line.npos || b==line.npos) syntaxBad_=true;
+                else {
+                    method_=line.substr(0,a); target_=line.substr(a+1,b-a-1);
+                    if(line.substr(b+1)!="HTTP/1.1") syntaxBad_=true;
+                }
+            } else if(line.empty()) { complete=true; break; }
+            else {
+                auto colon=line.find(':');
+                if(colon==line.npos) syntaxBad_=true;
+                auto name=colon==line.npos ? line : line.substr(0,colon);
+                auto value=colon==line.npos ? std::string_view{} : line.substr(colon+1);
+                if(!name.empty() && (name.back()==' ' || name.back()=='\t')) syntaxBad_=true;
+                while(!value.empty() && (value.front()==' ' || value.front()=='\t')) value.remove_prefix(1);
