+// SPDX-License-Identifier: GPL-3.0-or-later
+#include <trantor/net/BoundedIoInternal.h>
+#include <cerrno>
+#include <unistd.h>
+namespace trantor::bounded_io {
+namespace detail {
+std::atomic<U64> stock_output_appends{0}, constructed{0}, retained{0}, peak_retained{0};
+BootstrapBudget &bootstrap_budget() noexcept { static BootstrapBudget value; return value; }
+}
+
+namespace { std::atomic<int> wake_fd{-1}; bool gate_armed=false, gate_used=false; Slot *held=nullptr; }
+void bind_wake_fd(int fd) noexcept { wake_fd=fd; }
+// Coalesced nonblocking wake; the fixed scan also consumes deletion intents.
+void Slot::wake() noexcept {
+    const auto fd=wake_fd.load(std::memory_order_acquire);
+    if(fd<0) return;
+    const std::uint64_t one=1;
+    ssize_t result;
+    do { result=::write(fd,&one,sizeof(one)); } while(result<0 && errno==EINTR);
+    // EAGAIN means a wake is already pending; other errors retain the scan fallback.
+}
+void TcpDelete::operator()(TcpConnectionImpl*) const noexcept {
+    auto *s=slot;
+    s->inflight.fetch_add(1,std::memory_order_acq_rel);
+    s->destroy_tcp.store(true,std::memory_order_release); s->wake();
+    s->inflight.fetch_sub(1,std::memory_order_release);
+}
+bool arm_wire_gate() noexcept { if(gate_armed||gate_used) return false; gate_armed=true; return true; }
+bool take_wire_gate() noexcept { if(!gate_armed||gate_used) return false; gate_used=true; return true; }
+bool release_wire_gate() noexcept { if(!held) return false; held->gate=false; held=nullptr; return true; }
+// Called only with the real fixed application node, never a fabricated observer state.
+void hold_wire(Slot &s) noexcept { held=&s; }
+bool wire_held() noexcept {return held && held->gate;}
+void forget_wire(Slot &s) noexcept {if(held==&s)held=nullptr;s.gate=false;}
+}
