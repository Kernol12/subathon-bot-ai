+// Fixed wire ownership and close records are consumed only by the SDK IO0 scan.
+void TcpConnectionImpl::reading(bool on) noexcept {
+    if (!bounded_ || !loop_->isInLoopThread() || bounded_->closing) return;
+    const bool was_paused=bounded_->paused;
+    if(was_paused==!on) return;
+    bounded_->paused=!on;
+    if (on) {
+        ioChannelPtr_->enableReading();
+        if (was_paused && !bounded_->native_established && bounded_->resume_parser && bounded_->parser)
+            bounded_->resume_parser(bounded_->parser,&readBuffer_);
+    } else ioChannelPtr_->disableReading();
+}
+bool TcpConnectionImpl::wire(std::span<const std::byte> bytes,void *cookie) noexcept {
+    if (!bounded_ || !loop_->isInLoopThread() || bounded_->closing ||
+        !bounded_->output.empty() || bytes.empty()) return false;
+    bounded_->output=bytes; bounded_->cookie=cookie; bounded_->sent=0;
+    // Controls use the producer's actual fixed control slot as their cookie.
+    if (!bounded_->control_busy && bounded_io::take_wire_gate()) {
+        bounded_->gate=true; bounded_io::hold_wire(*bounded_);
+    }
+    if (!bounded_->gate) ioChannelPtr_->enableWriting();
+    return true;
+}
+void TcpConnectionImpl::close() noexcept {
+    if (!bounded_ || !loop_->isInLoopThread() || bounded_->closing) return;
+    bounded_->closing=true; bounded_->removal_epoch=loop_->boundedEpoch();
+    ioChannelPtr_->disableAll();
+}
+void TcpConnectionImpl::boundedTurn() noexcept {
+    if (!bounded_ || bounded_->removed || bounded_->closing || bounded_->gate) return;
+    if (bounded_->output.empty()) return;
+    if (!bounded_->producer->before_write(*bounded_->storage)) return;
+    const auto n=::send(socketPtr_->fd(),bounded_->output.data()+bounded_->sent,
+        std::min<std::size_t>(8192,bounded_->output.size()-bounded_->sent),MSG_NOSIGNAL);
+    if(n>0) bounded_->sent+=static_cast<std::size_t>(n);
+    else if(n<0 && errno!=EAGAIN && errno!=EWOULDBLOCK && errno!=EINTR) { close(); return; }
+    if(bounded_->sent==bounded_->output.size()) {
+        auto *cookie=bounded_->cookie; bounded_->output={}; bounded_->cookie=nullptr;
+        ioChannelPtr_->disableWriting(); bounded_->control_busy=false; bounded_->storage->wire_released(cookie);
+        if(bounded_->native_established && nativeProfileIo()) requestNativeProfileWrite();
+    } else ioChannelPtr_->enableWriting();
+}
+void TcpConnectionImpl::boundedRemove() noexcept {
+    if (!bounded_ || bounded_->removed) return;
+    status_=ConnStatus::Disconnected;
+    bounded_io::forget_wire(*bounded_);
+    ioChannelPtr_->disableAll(); ioChannelPtr_->remove();
+    socketPtr_->closeNativeProfile();
+    bounded_->storage->socket_removed();
+    if(!bounded_->output.empty()) {
+        auto *cookie=bounded_->cookie; bounded_->output={}; bounded_->cookie=nullptr;
+        bounded_->storage->wire_released(cookie);
+    }
+    auto native=std::atomic_exchange_explicit(&nativeProfileIo_,std::shared_ptr<NativeProfileIo>{},std::memory_order_acq_rel);
+    if(native) native->closed();
+    if(connectionCallback_) connectionCallback_(shared_from_this());
+    if(bounded_->destroy_parser && bounded_->parser) {
+        bounded_->destroy_parser(bounded_->parser); bounded_->parser=nullptr;
+    }
+    if(native) native->detached();
+    recvMsgCallback_={}; connectionCallback_={}; writeCompleteCallback_={}; closeCallback_={};
+    bounded_->removed=true;
+}
