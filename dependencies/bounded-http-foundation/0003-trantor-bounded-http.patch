+// SDK-only per-peer owners live inside the producer's preclaimed metadata slice.
+struct TRANTOR_EXPORT Slot {
+    Producer *producer;
+    PeerStorage *storage;
+    TcpServer *server;
+    Slot *next{};
+    std::shared_ptr<TcpConnection> connection;
+    void *parser{};
+    void (*destroy_parser)(void *) noexcept{};
+    void (*resume_parser)(void *, MsgBuffer *) noexcept{};
+    std::span<std::byte> memory;
+    std::size_t used{};
+    std::span<const std::byte> output{};
+    void *cookie{};
+    std::size_t sent{};
+    std::atomic<unsigned> inflight{0};
+    std::atomic<bool> destroy_tcp{false}, control_returned{false}, close_intent{false};
+    void *tcp_object{}, *ws_object{};
+    void (*destroy_ws_object)(void *) noexcept{};
+    std::atomic<bool> destroy_ws{false}, ws_control_returned{true};
+    bool tcp_constructed{};
+    bool ws_created{}, ws_destroyed{}, native{}, native_established{};
+    bool pending_parse{};
+    bool removed{}, destroyed{}, closing{}, paused{true}, gate{}, control_busy{};
+    U64 removal_epoch{};
+    alignas(64) std::byte control_block[512];
+    alignas(64) std::byte ws_control_block[512];
+    Slot(Producer &p, PeerStorage &s, TcpServer &owner, std::span<std::byte> m) noexcept
+        : producer(&p), storage(&s), server(&owner), memory(m), used((sizeof(Slot)+63)&~std::size_t(63)) {}
+    void *reserve(std::size_t n, std::size_t align) noexcept {
+        if (align > 64 || n > memory.size() || used > memory.size()-n) return nullptr;
+        auto *p=memory.data()+used;
+        const auto rounded=(n+63)&~std::size_t(63);
+        if (rounded<n || rounded>memory.size()-used) return nullptr;
+        used+=rounded; return p;
+    }
+    void *require(std::size_t n, std::size_t a) {
+        auto *p=reserve(n,a); if(!p) throw std::bad_alloc(); return p;
+    }
+    void wake() noexcept;
+};
+TRANTOR_EXPORT void bind_wake_fd(int) noexcept;
+TRANTOR_EXPORT bool arm_wire_gate() noexcept;
+TRANTOR_EXPORT bool release_wire_gate() noexcept;
+TRANTOR_EXPORT bool take_wire_gate() noexcept;
+TRANTOR_EXPORT bool wire_held() noexcept;
+TRANTOR_EXPORT void forget_wire(Slot &) noexcept;
+TRANTOR_EXPORT void hold_wire(Slot &) noexcept;
+template<class T> struct PlacementDelete {
+    bool placement{};
+    void operator()(T *p) const noexcept { if(p) { if(placement) p->~T(); else delete p; } }
+};
+template<class T> struct ControlAllocator {
+    using value_type=T;
+    Slot *slot;
+    bool websocket{};
+    explicit ControlAllocator(Slot *s, bool ws=false) noexcept:slot(s),websocket(ws){}
+    template<class U> ControlAllocator(const ControlAllocator<U>&a) noexcept:slot(a.slot),websocket(a.websocket){}
+    T *allocate(std::size_t n) {
+        static_assert(sizeof(T)<=512 && alignof(T)<=64, "Selected SDK control block exceeds its slot");
+        if(n!=1) throw std::bad_alloc();
+        return reinterpret_cast<T*>(websocket ? slot->ws_control_block : slot->control_block);
+    }
+    void deallocate(T *,std::size_t) noexcept {
+        auto *s=slot;
+        s->inflight.fetch_add(1,std::memory_order_acq_rel);
+        if(websocket) s->ws_control_returned.store(true,std::memory_order_release);
+        else s->control_returned.store(true,std::memory_order_release);
+        s->wake();
+        s->inflight.fetch_sub(1,std::memory_order_release);
+    }
+    template<class U> bool operator==(const ControlAllocator<U>&a) const noexcept{return slot==a.slot && websocket==a.websocket;}
+};
+struct TcpDelete { Slot *slot; void operator()(TcpConnectionImpl*) const noexcept; };
