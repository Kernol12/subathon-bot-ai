+bool TcpConnectionImpl::wire(std::span<const std::byte> bytes,void *cookie) noexcept {
+    if (!bounded_ || !loop_->isInLoopThread() || bounded_->closing ||
+        !bounded_->output.empty() || bytes.empty()) return false;
+    bounded_->output=bytes; bounded_->cookie=cookie; bounded_->sent=0;
+    // Controls use the producer's actual fixed control slot as their cookie.
+    if (cookie!=bounded_->storage->receive_with_prefix().data() &&
+        !bounded_->control_busy && bounded_io::take_wire_gate()) {
+        bounded_->gate=true; bounded_io::hold_wire(*bounded_);
+    }
+    if (!bounded_->gate) ioChannelPtr_->enableWriting();
+    return true;
