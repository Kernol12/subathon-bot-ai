{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent development progress state",
  "type": "object",
  "required": [
    "project",
    "baseline_version",
    "specification_version",
    "updated_at",
    "summary",
    "schema_version",
    "tasks",
    "verification",
    "activity"
  ],
  "properties": {
    "project": {
      "type": "string"
    },
    "baseline_version": {
      "type": "string"
    },
    "specification_version": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "status",
          "detail"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "status": {
            "$ref": "#/$defs/check"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "activity": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "task",
          "note"
        ],
        "properties": {
          "date": {
            "type": "string"
          },
          "task": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "workflow_policy": {
      "$ref": "#/$defs/workflow_policy"
    }
  },
  "$defs": {
    "check": {
      "enum": [
        "blocked",
        "draft",
        "failed",
        "not_run",
        "observed_red",
        "partial",
        "passed"
      ]
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "title",
        "module",
        "owner",
        "brief",
        "summary",
        "kind",
        "status",
        "depends_on",
        "spec_refs",
        "notes",
        "verification",
        "evidence",
        "review"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "module": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "brief": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "code_review",
            "cleanup",
            "contract",
            "environment",
            "epic",
            "feasibility",
            "implementation",
            "scaffold",
            "test_baseline",
            "test_draft",
            "test_review"
          ]
        },
        "status": {
          "enum": [
            "blocked",
            "done",
            "in_progress",
            "in_review",
            "planned",
            "ready"
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "spec_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/check"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "anyOf": [
              {
                "format": "uri",
                "pattern": "^https://[^\\s]+$"
              },
              {
                "not": {
                  "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
                }
              }
            ]
          }
        },
        "review": {
          "type": [
            "null",
            "object"
          ],
          "properties": {
            "author": {
              "type": "string"
            },
            "reviewer": {
              "type": "string"
            },
            "outcome": {
              "enum": [
                "approved",
                "changes_requested"
              ]
            }
          }
        },
        "workflow": {
          "$ref": "#/$defs/workflow"
        },
        "publication": {
          "$ref": "#/$defs/publication"
        }
      }
    },
    "workflow_policy": {
      "type": "object",
      "required": [
        "version",
        "legacy_done",
        "legacy_done_sha256"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "legacy_done": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "legacy_done_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "stage_review": {
      "type": "object",
      "required": [
        "phase",
        "provider",
        "model",
        "reviewer",
        "revision",
        "outcome",
        "evidence",
        "findings",
        "blocking_findings"
      ],
      "properties": {
        "phase": {
          "enum": [
            "initial",
            "verification",
            "closing"
          ]
        },
        "provider": {
          "enum": [
            "claude",
            "codex"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "outcome": {
          "enum": [
            "approved",
            "changes_requested"
          ]
        },
        "evidence": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^\\s]+$"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "blocking_findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "review_stage": {
      "type": "object",
      "required": [
        "authors",
        "revision",
        "paths",
        "reviews"
      ],
      "properties": {
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "reviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stage_review"
          }
        }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": [
        "required_stages",
        "stages"
      ],
      "properties": {
        "required_stages": {
          "type": "array",
          "items": {
            "enum": [
              "contract",
              "tests",
              "implementation"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "stages": {
          "type": "object",
          "properties": {
            "contract": {
              "$ref": "#/$defs/review_stage"
            },
            "tests": {
              "$ref": "#/$defs/review_stage"
            },
            "implementation": {
              "$ref": "#/$defs/review_stage"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "publication": {
      "type": "object",
      "required": [
        "state",
        "pr",
        "head",
        "merge_commit",
        "merged_at",
        "observed_at"
      ],
      "properties": {
        "state": {
          "enum": [
            "open",
            "merged"
          ]
        },
        "pr": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^\\s]+$"
        },
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "merge_commit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "merged_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  }
}
